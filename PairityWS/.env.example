NODE_ENV=development
PORT=5001

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Use two independent random secrets, each at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Pairity <auth@your-verified-domain.example>

CORS_ORIGIN_WEBSITE=https://pairity.app
CORS_ORIGIN_APP=https://app.pairity.app
APP_URL=https://app.pairity.app
